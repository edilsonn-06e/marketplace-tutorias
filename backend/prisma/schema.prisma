generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}
enum UserStatus {
  ACTIVE
  SUSPENDED
}
enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}
enum TutorApproval {
  PENDING
  APPROVED
  REJECTED
}
enum Modality {
  VIRTUAL
  TUTOR_PLACE
  STUDENT_HOME
}
enum SubscriptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
enum SessionStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}
enum ReportReason {
  NO_SHOW
  INAPPROPRIATE_CONDUCT
  UNDUE_CHARGES
  OTHER
}
enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}
enum AppealStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id              String     @id @default(uuid())
  googleId        String     @unique
  email           String     @unique
  name            String
  photoUrl        String?
  role            Role?
  onboarded       Boolean    @default(false)
  phone           String?
  gender          Gender?
  address         String?
  lat             Float?
  lng             Float?
  idDocument      String?
  status          UserStatus @default(ACTIVE)
  suspendedReason String?
  suspendedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tutorProfile          TutorProfile?
  categories            UserCategory[]
  offers                Offer[]
  availability          Availability[]
  studentSubscriptions  Subscription[] @relation("StudentSubscriptions")
  tutorSubscriptions    Subscription[] @relation("TutorSubscriptions")
  studentSessions       Session[]      @relation("StudentSessions")
  tutorSessions         Session[]      @relation("TutorSessions")
  reviewsGiven          Review[]       @relation("ReviewsGiven")
  reviewsReceived       Review[]       @relation("ReviewsReceived")
  conversationsAsStudent Conversation[] @relation("ConvStudent")
  conversationsAsTutor  Conversation[] @relation("ConvTutor")
  messages              Message[]
  reportsMade           Report[]       @relation("ReportsMade")
  reportsReceived       Report[]       @relation("ReportsReceived")
  appeals               Appeal[]
  auditLogs             AuditLog[]
}

model TutorProfile {
  userId      String        @id
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String
  cvUrl       String
  baseRate    Float
  approval    TutorApproval @default(PENDING)
  avgRating   Float         @default(0)
  reviewCount Int           @default(0)
}

model Category {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  parentId    String?
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[]     @relation("CategoryTree")
  users       UserCategory[]
  offers      Offer[]
  createdAt   DateTime       @default(now())
}

model UserCategory {
  userId     String
  categoryId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
}

model Offer {
  id            String         @id @default(uuid())
  tutorId       String
  tutor         User           @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  title         String
  description   String?
  modalities    Modality[]
  hourlyRate    Float
  perKmRate     Float          @default(0)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]

  @@index([categoryId])
}

model Availability {
  id          String @id @default(uuid())
  tutorId     String
  tutor       User   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startMinute Int
  endMinute   Int

  @@index([tutorId])
}

model Subscription {
  id                   String             @id @default(uuid())
  studentId            String
  student              User               @relation("StudentSubscriptions", fields: [studentId], references: [id])
  tutorId              String
  tutor                User               @relation("TutorSubscriptions", fields: [tutorId], references: [id])
  offerId              String
  offer                Offer              @relation(fields: [offerId], references: [id])
  modality             Modality
  startDate            DateTime
  weeks                Int
  daysOfWeek           Int[]
  startMinute          Int
  durationMinutes      Int
  distanceKm           Float?
  classCostPerSession  Float
  travelCostPerSession Float              @default(0)
  totalCost            Float
  notes                String?
  status               SubscriptionStatus @default(PENDING)
  createdAt            DateTime           @default(now())
  sessions             Session[]
}

model Session {
  id             String        @id @default(uuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tutorId        String
  tutor          User          @relation("TutorSessions", fields: [tutorId], references: [id])
  studentId      String
  student        User          @relation("StudentSessions", fields: [studentId], references: [id])
  startAt        DateTime
  endAt          DateTime
  status         SessionStatus @default(PENDING)
  review         Review?

  @@index([tutorId, startAt])
  @@index([studentId, startAt])
}

model Review {
  id        String   @id @default(uuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("ReviewsGiven", fields: [studentId], references: [id])
  tutorId   String
  tutor     User     @relation("ReviewsReceived", fields: [tutorId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Conversation {
  id        String    @id @default(uuid())
  studentId String
  student   User      @relation("ConvStudent", fields: [studentId], references: [id])
  tutorId   String
  tutor     User      @relation("ConvTutor", fields: [tutorId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@unique([studentId, tutorId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  reporter   User         @relation("ReportsMade", fields: [reporterId], references: [id])
  reportedId String
  reported   User         @relation("ReportsReceived", fields: [reportedId], references: [id])
  reason     ReportReason
  evidence   String
  status     ReportStatus @default(OPEN)
  adminNote  String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
}

model Appeal {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  message       String
  status        AppealStatus @default(PENDING)
  adminResponse String?
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}